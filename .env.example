# Required for Vercel deployment
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true&connection_limit=1"
SESSION_SECRET="replace-with-a-strong-random-secret"

# Email (Resend)
RESEND_API_KEY="re_xxxxxxxx"
FROM_EMAIL="notifications@huddlebase.com"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Payments (Stripe Checkout)
STRIPE_SECRET_KEY="sk_live_xxxxxxxx"

# Photo & video storage (Vercel Blob)
# Attach a Blob store to the project and Vercel injects this automatically;
# locally, run `vercel env pull`. Without it, media uploads return 503.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# Mobile push notifications (Expo)
# Only needed if you have enabled enhanced push security in your Expo account.
# Standard Expo projects send without a server credential.
# EXPO_ACCESS_TOKEN="xxxxxxxx"

# AI practice plan generator
OPENAI_API_KEY="sk-proj_xxxxxxxx"
AI_PRACTICE_PLAN_MODEL="gpt-5-mini"
AI_PRACTICE_PLAN_PREMIUM_MODEL="gpt-5.2"
AI_PRACTICE_PLAN_MONTHLY_LIMIT="30"
AI_PRACTICE_PLAN_MAX_OUTPUT_TOKENS="3000"
