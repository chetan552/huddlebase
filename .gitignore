# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Environment and secrets
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p8
*.p12
*.jks
*.mobileprovision

# Dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output and generated files
/.next/
/out/
/build/
/dist/
.turbo/
.swc/
next-env.d.ts
*.tsbuildinfo
/src/generated/prisma/

# Prisma local databases
prisma/*.db
prisma/*.db-journal

# Testing and reports
/coverage/
/playwright-report/
/test-results/

# Expo and React Native
.expo/
expo-env.d.ts
web-build/
.metro-health-check*
.kotlin/
*.orig.*
/ios/
/android/

# Hosting and deployment
.vercel/
.netlify/

# Logs and diagnostics
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# OS and editor state
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
